# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'BookScanner' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # =========================================================================
    # AFTER react_native_post_install: Apply Xcode 26 undefined_arch fixes
    # =========================================================================

    installer.pods_project.targets.each do |target|
      # Global build hardening for all pods
      target.build_configurations.each do |bc|
        bc.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        bc.build_settings['CLANG_ENABLE_MODULES'] = 'YES'
        bc.build_settings['GCC_WARN_ABOUT_DEPRECATED_FUNCTIONS'] = 'NO'

        # Force valid ARCHS globally to avoid undefined_arch
        bc.build_settings['ARCHS'] = '$(ARCHS_STANDARD)'
        bc.build_settings['ONLY_ACTIVE_ARCH'] = 'YES'

        # Fix pods with old deployment targets (react-native-image-picker etc.)
        bc.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end

      # Fix RCTSwiftUI/RCTSwiftUIWrapper Swift toolchain stalls
      if ['RCTSwiftUI', 'RCTSwiftUIWrapper'].include?(target.name)
        target.build_configurations.each do |bc|
          bc.build_settings['SWIFT_USE_INTEGRATED_DRIVER'] = 'NO'
          bc.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'
          bc.build_settings['COMPILATION_CACHE_CAS_PATH'] = ''
          bc.build_settings['COMPILATION_CACHE_KEEP_CAS_DIRECTORY'] = 'NO'
        end
      end

      # Xcode 26 global fix: Patch ALL shell script phases to handle undefined_arch
      target.build_phases.each do |phase|
        if phase.is_a?(Xcodeproj::Project::Object::PBXShellScriptBuildPhase)
          original_script = phase.shell_script || ""

          # Skip if already patched
          next if original_script.include?('[Podfile patch]')

          # Wrap script with undefined_arch guard
          arch_guard = <<~GUARD
            # [Podfile patch] Xcode 26 undefined_arch fix
            if [ "${arch:-}" = "undefined_arch" ] || [ "${CURRENT_ARCH:-}" = "undefined_arch" ]; then
              if [ "${PLATFORM_NAME:-}" = "iphoneos" ]; then
                export arch="arm64"
                export CURRENT_ARCH="arm64"
                export ARCHS="arm64"
              elif [ "${PLATFORM_NAME:-}" = "iphonesimulator" ]; then
                export arch="arm64"
                export CURRENT_ARCH="arm64"
                export ARCHS="arm64 x86_64"
              fi
            fi

          GUARD

          phase.shell_script = arch_guard + original_script
        end
      end
    end

    # Save the modified project
    installer.pods_project.save
  end
end
